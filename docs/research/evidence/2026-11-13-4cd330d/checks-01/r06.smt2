(set-logic QF_BV)
(set-option :timeout 4000)
(declare-const x (_ BitVec 64))
(declare-const a (_ BitVec 64))
(declare-const b (_ BitVec 64))
(define-fun reference () (_ BitVec 64) (bvadd (bvadd x a) b))
(push)
(assert (distinct reference (bvadd x (bvadd a b))))
(check-sat)
(pop)
(push)
(assert (distinct reference (bvsub x (bvneg (bvadd a b)))))
(check-sat)
(pop)
(assert (distinct reference (bvadd reference (_ bv1 64))))
(check-sat)
